# Docker Compose 初始化数据库配置
MYSQL_DATABASE=wms
MYSQL_USER=wms
MYSQL_PASSWORD=wms123456
MYSQL_ROOT_PASSWORD=root123456

# Spring Boot 可选覆盖项（默认值与上面保持一致）
MYSQL_URL='jdbc:mysql://localhost:3306/wms?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia%2FShanghai'
MYSQL_USERNAME=wms
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 生产环境必须替换为足够长的随机值
WMS_TOKEN_SECRET=abcdefghijklmnopqrstuvwxyz012345
WMS_UPLOAD_PATH=./data/uploadPath

# 本地调试开关；生产环境应保持关闭
SPRINGDOC_ENABLED=true
DRUID_WEB_STAT_ENABLED=false
DRUID_CONSOLE_ENABLED=false
DRUID_ALLOW=127.0.0.1
DRUID_USERNAME=druid_admin
DRUID_PASSWORD=replace-before-enabling
